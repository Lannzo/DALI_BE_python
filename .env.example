# ==============================================================
# DALI E-Commerce - Environment Configuration Template
# ==============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ==============================================================

# -------------------- DATABASE --------------------
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/dali_db

# -------------------- SECURITY --------------------
# Secret keys (generate random strings for production)
# You can generate using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key-at-least-32-chars
SESSION_SECRET_KEY=change-this-to-another-random-secret-key

# JWT Settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
SESSION_MAX_AGE=86400

# -------------------- EMAIL (SMTP) --------------------
# Gmail SMTP settings (use App Password, not regular password)
# See: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=noreply@dalicommerce.com
SMTP_FROM_NAME=DALI E-Commerce

# -------------------- PAYMENT (MAYA SANDBOX) --------------------
# Maya/PayMaya Sandbox API credentials
# Get from: https://developers.maya.ph/
MAYA_API_KEY=
MAYA_SECRET_KEY=
MAYA_PUBLIC_KEY=
MAYA_BASE_URL=https://pg-sandbox.paymaya.com

# -------------------- APPLICATION URLs --------------------
# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:5173

# Payment callback URLs
PAYMENT_SUCCESS_URL=http://localhost:5173/payment/callback/success
PAYMENT_FAILURE_URL=http://localhost:5173/payment/callback/failure
PAYMENT_CANCEL_URL=http://localhost:5173/payment/callback/cancel

# -------------------- WAREHOUSE --------------------
# Default warehouse coordinates (Metro Manila)
WAREHOUSE_LAT=14.5995
WAREHOUSE_LON=120.9842

# -------------------- PATHS --------------------
STATIC_FILES_PATH=src/main/resources/static
TEMPLATES_PATH=src/main/resources/templates

# -------------------- LOGGING --------------------
LOG_LEVEL=INFO

# -------------------- ADMIN SEEDING (OPTIONAL) --------------------
# Set these to auto-create admin accounts on startup
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=your_admin_password
# SUPER_ADMIN_EMAIL=superadmin@example.com
# SUPER_ADMIN_PASSWORD=your_super_admin_password
